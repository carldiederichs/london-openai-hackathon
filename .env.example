# Keep real values in .env.local, which Git ignores.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4174
# Use a reachable LAN URL for phone QR codes when the host opens localhost.
# PUBLIC_URL=http://YOUR_LAN_ADDRESS:4173

# Production uses ChatGPT Sites only, with the same-origin API and managed DB.
# The optional VITE_WORLD_API_URL belongs only to the unused external-backend prototype.
# Local development only: optional Vite proxy override.
# DEV_API_URL=http://127.0.0.1:4174
