# Keep real values in .env.local, which Git ignores.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4174
# Use a reachable LAN URL for phone QR codes when the host opens localhost.
# PUBLIC_URL=http://YOUR_LAN_ADDRESS:4173

# Sites frontend connecting to the deployed Durable Object worker (public URL, not a secret).
VITE_GAME_BACKEND=
VITE_GAME_TRANSPORT=
