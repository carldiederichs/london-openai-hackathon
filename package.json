{
  "name": "feral",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run build:sites",
    "preview": "npm run sites:dev",
    "test": "node --experimental-sqlite --import tsx --test server/*.test.ts src/live/*.test.ts",
    "test:durable": "tsx scripts/check-durable.ts",
    "test:load": "tsx scripts/load-realtime.ts",
    "dev:web": "vite",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev --port 8787",
    "worker:check": "tsc --noEmit -p tsconfig.worker.json",
    "worker:deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "build:sites": "tsc -b && vite build --outDir dist/client && node scripts/build-sites.mjs",
    "sites:check": "tsc --noEmit -p tsconfig.sites.json",
    "sites:dev": "wrangler dev -c wrangler.sites.jsonc --port 8792",
    "sites:migrate": "wrangler d1 migrations apply feral-local --local -c wrangler.sites.jsonc",
    "build:web": "tsc -b && vite build",
    "test:sites": "tsx scripts/check-sites.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "openai": "^7.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "wrangler": "^4.156.0",
    "ws": "^8.22.1"
  }
}
